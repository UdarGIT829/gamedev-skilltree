[node name="Skill Branch" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_rsxem")
data = ExtResource("2_vthio")
progress = SubResource("Resource_d6fe4")
claims = Array[String](["One game object can use multiple images depending on what it is doing or how it should look.
", "Movement buttons create velocity in a direction. Gravity creates acceleration toward Earth. A downward-pointing fan and gravity can therefore produce the same movement effect.", "A sprite is pixels drawn inside a square, but the object's collision or overlap shape does not need to be that square.", "I can arrange pixels of different colors so they appear to blend into another color or shade.", "I can deliberately control the colors in a game so the artwork feels consistent and stylish.", "I can reduce an image to a chosen palette by replacing similar colors with selected colors.", "Lighting in a game should prioritize style, even when it does not behave like real light.", "A 3D object is made of vertices positioned in space and the triangles that connect them.", "I can create and remove objects based on what part of the world the player can currently see.", "When the game creates objects automatically, it still needs rules for where those objects are allowed to appear.", "I should fully understand where a character can and cannot move based on its code WITHOUT running the game. ", "The color of the triangles between 3D vertices can be calculated with a fragment shader.", "A vertex shader can change where 3D vertices appear to be without automatically changing the object's physics."])
claim_skill_ids = Array[StringName]([&"multipleimages", &"velocityandacceleration", &"complexcollisionboxes", &"dithering", &"colorpalettes", &"colorquantization", &"unrealisticlighting", &"3dvertexandtris", &"viewportspawning", &"placementrules", &"pathing", &"fragmentshader", &"vertexshader"])

